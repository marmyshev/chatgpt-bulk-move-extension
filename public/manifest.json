{
  "manifest_version": 3,
  "name": "ChatGPT Bulk Move Chats",
  "description": "Lists your ChatGPT conversations, lets you select them, and bulk-moves them into a project through ChatGPT's own backend API.",
  "version": "0.3.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "Bulk move ChatGPT chats",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
